# GridPulse local stack — copy to .env and adjust. NEVER commit real secrets.
# Synthetic/public data only. `make up` auto-creates .env from this file if missing.

# --- Warehouse (Postgres 18) ---------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres            # dev only; change for anything shared
POSTGRES_DB=lakehouse
WAREHOUSE_PORT=5432
# App/dbt connection string to the warehouse:
WAREHOUSE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lakehouse

# --- Airflow 3.3 ----------------------------------------------------------
AIRFLOW_PORT=8080
AIRFLOW_UID=50000
# Fernet key encrypts connection/variable secrets. This is a DEV placeholder —
# regenerate for anything real:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
# Login is admin / admin, pinned by deploy/airflow/simple_auth_manager_passwords.json.generated

# --- Superset -------------------------------------------------------------
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=gridpulse-dev-secret-change-me
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@example.com

# --- Pipeline / SRE knobs (used by builder + observability layers) --------
FRESHNESS_DEADLINE=06:00
ALERT_DQ_PASS_RATE_MIN=0.98
# COMPLETENESS_DROP alert (per zone + ALL): fires below the floor, or when a
# day drops more than DROP_PTS below the scope's previous-7-day mean.
ALERT_COMPLETENESS_MIN_PCT=90
ALERT_COMPLETENESS_DROP_PTS=2.0
HEALTH_PORT=8000
